MARK_BEGIN="# >>> ordering.co mcp >>>"
MARK_END="# <<< ordering.co mcp <<<"

shell_profile() {
  case "$(basename "${SHELL:-}")" in
    zsh) echo "${ZDOTDIR:-$HOME}/.zshrc" ;;
    bash) if [ "$(uname)" = "Darwin" ]; then echo "$HOME/.bash_profile"; else echo "$HOME/.bashrc"; fi ;;
    *) echo "" ;;
  esac
}

remove_profile_block() {
  local f="$1" tmp
  [ -f "$f" ] || return 0
  grep -qF "$MARK_BEGIN" "$f" || return 0
  tmp="$(tmpfile)"
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" '$0 == b {skip=1; next} $0 == e {skip=0; next} !skip' "$f" > "$tmp"
  cat "$tmp" > "$f"
}

# The official Claude Code plugin: the MCP server plus a skill that knows the platform.
# The key goes to the system keychain through stdin, never through arguments.
PLUGIN_REPO="Ordering-co/ordering-mcp-plugin"
PLUGIN_MARKETPLACE="ordering-dev"
PLUGIN_ID="ordering@$PLUGIN_MARKETPLACE"

# Prints: installed | available | conflict | unknown
claude_plugin_state() {
  local markets plugins repo
  have jq || { echo unknown; return; }
  markets="$(claude plugin marketplace list --json 2>/dev/null || true)"
  plugins="$(claude plugin list --json 2>/dev/null || true)"
  repo="$(printf '%s' "$markets" | jq -r --arg m "$PLUGIN_MARKETPLACE" '.[]? | select(.name == $m) | .repo // .url // .source' 2>/dev/null | head -1)"
  if [ -z "$repo" ]; then echo available
  elif [ "$repo" != "$PLUGIN_REPO" ]; then echo conflict
  elif printf '%s' "$plugins" | jq -e --arg id "$PLUGIN_ID" '.[]? | select(.id == $id)' >/dev/null 2>&1; then echo installed
  else echo available
  fi
}


# Prints the MCP variables from .env as shell exports, for your shell profile.
# The REST API key is never exported this way.
cmd_shell_env() {
  local k
  for k in ORDERING_PROJECT ORDERING_MCP_KEY; do
    [ -n "${!k:-}" ] && printf 'export %s=%q\n' "$k" "${!k}"
  done
  return 0
}

# Dependencies are locked separately; the login/API helper itself remains bash-only.
client_runtime() {
  if ! have node || ! have npm; then
    die "Global multi-client setup requires Node.js 22+ and npm. Login is saved; install Node, then rerun ./ordering install."
  fi
  node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' || die "Node.js 22+ is required."
  mkdir -p "$ROOT/.clients"
  chmod 700 "$ROOT/.clients"
  if ! cmp -s "$ROOT/client-installer/package-lock.json" "$ROOT/.clients/runtime-ready" ||
    [ ! -f "$ROOT/.clients/node_modules/mcp-remote/dist/proxy.js" ] ||
    [ ! -f "$ROOT/.clients/node_modules/add-mcp/dist/lib.js" ] ||
    [ ! -f "$ROOT/.clients/node_modules/jsonc-parser/lib/umd/main.js" ]; then
    rm -f "$ROOT/.clients/runtime-ready"
    cp "$ROOT/client-installer/package.json" "$ROOT/client-installer/package-lock.json" "$ROOT/.clients/"
    # npm 11 can infer a different root with --prefix when the caller has no
    # package.json. Run against the runtime's own package and frozen lockfile.
    (cd "$ROOT/.clients" && npm ci --ignore-scripts --no-audit --no-fund) >&2 || die "Could not prepare the client installer. Login is saved; rerun ./ordering install."
    if [ ! -f "$ROOT/.clients/node_modules/mcp-remote/dist/proxy.js" ] ||
      [ ! -f "$ROOT/.clients/node_modules/add-mcp/dist/lib.js" ] ||
      [ ! -f "$ROOT/.clients/node_modules/jsonc-parser/lib/umd/main.js" ]; then
      die "Client runtime is incomplete. Login is saved; rerun ./ordering install."
    fi
    cp "$ROOT/client-installer/package-lock.json" "$ROOT/.clients/runtime-ready"
  fi
  command -v node > "$ROOT/.clients/node-path"
  chmod 600 "$ROOT/.clients/node-path"
}

client_action() {
  [ -f "$ROOT/.clients/node-path" ] || die "Clients are not installed. Run ./ordering install."
  local node_path; node_path="$(cat "$ROOT/.clients/node-path")"
  "$node_path" "$ROOT/scripts/client-installer.mjs" "$ROOT" "$1" "${ORDERING_PROJECT:-}"
}

cmd_mcp() {
  require_project
  [ -n "${ORDERING_MCP_KEY:-}" ] || die "No MCP key. Run ./ordering login."
  [ -f "$ROOT/.clients/node-path" ] || die "MCP launcher is not installed. Run ./ordering install."
  local node_path; node_path="$(cat "$ROOT/.clients/node-path")"
  [ -x "$node_path" ] || die "The Node runtime moved. Rerun ./ordering install."
  # The inherited REST key must never reach MCP clients or their proxy.
  unset ORDERING_API_KEY
  rm -rf "$TMP_DIR"
  # Placeholder stays literal in argv; mcp-remote resolves it from the environment.
  # shellcheck disable=SC2016
  set -- --transport http-only --header 'Authorization:Bearer ${ORDERING_MCP_KEY}' --silent
  case "$API_HOST" in http://127.0.0.1:*) set -- "$@" --allow-http ;; esac
  exec "$node_path" "$ROOT/.clients/node_modules/mcp-remote/dist/proxy.js" "$(mcp_url)" "$@"
}

cmd_install() {
  require_project
  [ -n "${ORDERING_MCP_KEY:-}" ] || die "ORDERING_MCP_KEY is empty. Run ./ordering login."
  title "Verify the connection"
  mcp_whoami "$ORDERING_PROJECT" "$ORDERING_MCP_KEY"
  if [ "$HTTP_CODE" != 200 ] || [ "$(json_get "$MCP_BODY" result.structuredContent.project)" != "$ORDERING_PROJECT" ]; then
    die "MCP verification failed; no client configuration changed."
  fi
  ok "Authenticated on project '$ORDERING_PROJECT'"
  unset ORDERING_API_KEY
  client_runtime
  title "Verify the desktop-safe MCP launcher"
  client_action probe || die "MCP launcher failed. No client configuration changed."
  title "Register detected clients globally"
  client_action install || die "Some clients were not registered. Review the individual results; do not treat this as complete."
  title "Verify registrations"
  client_action status || die "Some registrations could not be verified."
  echo
  ok "MCP authenticated, launcher verified, and detected clients registered."
  hint "Restart running clients or reload their MCP settings, then ask: Who am I in Ordering?"
}

# Without the ownership manifest, a server named "ordering" may belong to another
# setup or session. Preserve legacy native entries rather than removing by name.
remove_mcp_registrations() {
  local config_file profile needs_review=0
  for config_file in "$HOME/.claude.json" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.claude.json"; do
    if [ -f "$config_file" ] && grep -Eq '"ordering"[[:space:]]*:' "$config_file"; then
      warn "Claude Code: legacy Ordering configuration preserved (no ownership record). Review it in your client."
      needs_review=1
      break
    fi
  done
  config_file="${CODEX_HOME:-$HOME/.codex}/config.toml"
  if [ -f "$config_file" ] && grep -Eq "^[[:space:]]*\\[[[:space:]]*[\"']?mcp_servers[\"']?[[:space:]]*\\.[[:space:]]*[\"']?ordering[\"']?[[:space:]]*\\]" "$config_file"; then
    warn "Codex: legacy Ordering configuration preserved (no ownership record). Review it in your client."
    needs_review=1
  fi
  [ "$needs_review" -eq 0 ] || return 1
  profile="$(shell_profile)"
  if [ -n "$profile" ]; then
    remove_profile_block "$profile"
    ok "Removed the Ordering block from $profile"
  fi
}

cmd_uninstall() {
  if [ -f "$ROOT/.clients/installed.json" ]; then
    client_action uninstall || die "Some changed registrations were preserved; review the results."
    local profile; profile="$(shell_profile)"
    [ -z "$profile" ] || remove_profile_block "$profile"
  else
    remove_mcp_registrations || die "Legacy registrations need review before disconnecting; no native entries or credentials were removed."
  fi
  ok "Your .env and your keys were not touched. Revoke unwanted keys in the Dashboard."
  hint "Reload running clients to drop cached tools and credentials."
}

# True if this Claude Code CLI's 'plugin' subcommand has an 'uninstall' action.
# Older CLIs don't, so the plugin has to be removed from Settings > Plugins instead.
claude_plugin_can_uninstall() {
  have claude || return 1
  claude plugin --help 2>/dev/null | grep -q 'uninstall'
}

DASHBOARD_MCP_URL="https://dashboard.ordering.co/settings?group=developers&category=developers&id=mcpTokens"
DASHBOARD_API_KEYS_URL="https://dashboard.ordering.co/settings?group=developers&category=developers&id=apiKeys"

# Disconnects this folder: removes the key from .env (keeps the project), removes the
# Claude Code plugin or server and the Codex server, and removes the shell integration.
# The key itself is never printed, and nothing here revokes it on the server: that's
# the developer's call, from the Dashboard link this prints.
cmd_logout() {
  local key_name=""
  if [ -n "${ORDERING_PROJECT:-}" ] && [ -n "${ORDERING_MCP_KEY:-}" ]; then
    if mcp_whoami "$ORDERING_PROJECT" "$ORDERING_MCP_KEY" && [ "$HTTP_CODE" = "200" ]; then
      key_name="$(json_get "$MCP_BODY" result.structuredContent.token.name)"
    fi
  fi

  title "Shell and agents"
  cmd_uninstall
  if have claude && [ "$(claude_plugin_state)" = "installed" ]; then
    if claude_plugin_can_uninstall; then
      if claude plugin uninstall "$PLUGIN_ID" >/dev/null 2>&1; then
        ok "Claude Code: Ordering plugin uninstalled"
      else
        warn "Could not uninstall the Claude Code plugin. Run: claude plugin uninstall $PLUGIN_ID"
      fi
    else
      warn "This Claude Code can't uninstall plugins from the CLI."
      hint "Remove it yourself: claude plugin uninstall $PLUGIN_ID (or Settings > Plugins)"
    fi
  fi

  title "Key"
  local had_api_key=""
  if [ -f "$ENV_FILE" ]; then
    set_env_line ORDERING_MCP_KEY ""
    ok "Removed the MCP key from .env (your project stays set)"
    if [ -n "${ORDERING_API_KEY:-}" ]; then
      had_api_key=1
      set_env_line ORDERING_API_KEY ""
      ok "Removed the REST API key from .env"
    fi
  else
    ok "No .env here."
  fi

  echo
  if [ -n "$key_name" ]; then
    printf '  Key "%s%s%s" is no longer used here.\n' "$C_B" "$key_name" "$C_0"
  else
    printf '  No MCP key was in use here.\n'
  fi
  printf '  %sThis key still works until you revoke it.%s\n' "$C_WARN" "$C_0"
  printf '  %s\n' "$DASHBOARD_MCP_URL"
  if [ -n "$had_api_key" ]; then
    printf '  %sThe REST API key still works until you revoke it too, in Dashboard > Settings > Developers > API Keys.%s\n' "$C_WARN" "$C_0"
    printf '  %s\n' "$DASHBOARD_API_KEYS_URL"
  fi
  echo
  if ! is_agent_session && [ -z "${ORDERING_NO_BROWSER:-}" ] && [ -z "${SSH_CONNECTION:-}" ]; then
    if [ "$(uname)" = "Darwin" ]; then open "$DASHBOARD_MCP_URL" 2>/dev/null || true
    elif have xdg-open && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then xdg-open "$DASHBOARD_MCP_URL" >/dev/null 2>&1 || true
    fi
  fi
}

cmd_reset() {
  cmd_logout
  cmd_login "$@"
}

# ---------------------------------------------------------------- api

AUDIT_LOG="$ROOT/.api-audit.log"

# redact_secrets <file>: replaces the current ORDERING_API_KEY and ORDERING_MCP_KEY
# values with *** in place. The values travel through awk's environment (ENVIRON),
# never as a -v argument, so they never show up in this process's argv.
redact_secrets() {
  local f="$1" tmp
  [ -n "${ORDERING_API_KEY:-}${ORDERING_MCP_KEY:-}" ] || return 0
  tmp="$(tmpfile)"
  REDACT_API_KEY="${ORDERING_API_KEY:-}" REDACT_MCP_KEY="${ORDERING_MCP_KEY:-}" awk '
    BEGIN { a = ENVIRON["REDACT_API_KEY"]; m = ENVIRON["REDACT_MCP_KEY"] }
    {
      line = $0
      if (length(a) > 0) gsub(a, "***", line)
      if (length(m) > 0) gsub(m, "***", line)
      print line
    }
  ' "$f" > "$tmp"
  cat "$tmp" > "$f"
}

# audit_log METHOD PATH DATA: appends one line to .api-audit.log for a write that
# was actually confirmed and sent (never for a refusal). Logs the method, the path
# with control characters stripped, and a sha256 of the body, never the body itself.
audit_log() {
  local method="$1" path="$2" data="$3" ts path_clean body_hash
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  path_clean="$(printf '%s' "$path" | tr -d '\000-\037\177')"
  if [ -n "$data" ]; then
    case "$data" in
      @*) body_hash="$(sha256_hex < "${data#@}")" ;;
      *)  body_hash="$(printf '%s' "$data" | sha256_hex)" ;;
    esac
  else
    body_hash="-"
  fi
  : >> "$AUDIT_LOG"
  chmod 600 "$AUDIT_LOG" 2>/dev/null || true
  printf '%s %s %s sha256=%s\n' "$ts" "$method" "$path_clean" "$body_hash" >> "$AUDIT_LOG"
}

cmd_api() {
  # --yes may appear anywhere after 'api': ./ordering api --yes POST /x '{}' and
  # ./ordering api POST --yes /x '{}' are both valid.
  local yes="" rest=() a
  for a in "$@"; do
    case "$a" in
      --yes) yes=1 ;;
      *) rest+=("$a") ;;
    esac
  done
  set -- "${rest[@]}"
  [ $# -ge 2 ] || die 'Usage: ./ordering api [--yes] METHOD PATH [JSON | @file.json]   e.g. ./ordering api GET "/orders?page_size=5&mode=dashboard"'
  require_project
  [ -n "${ORDERING_API_KEY:-}" ] || die "ORDERING_API_KEY is empty. Add it to .env (see .env.example)."

  local method path data
  method="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"; path="$2"; data="${3:-}"
  case "$method" in GET|POST|PUT|PATCH|DELETE) ;; *) die "Unsupported method: $method" ;; esac
  case "$path" in /*) ;; *) path="/$path" ;; esac
  case "$path" in *://*) die "PATH must be relative, e.g. /orders" ;; esac
  if [ "$method" = "GET" ] && [ -n "$data" ]; then
    die "GET does not take a body. Pass a JSON body only with POST, PUT, PATCH or DELETE."
  fi

  if [ "$method" != "GET" ]; then
    # Writes need either a person at an interactive terminal, or an agent passing --yes
    # after the person approved this exact request in the chat. This is a guardrail
    # against accidental writes, not a security boundary: anyone with the key can call
    # the API directly.
    if [ -n "$yes" ]; then
      printf 'CONFIRMED %s %s on %s\n' "$method" "$path" "$ORDERING_PROJECT" >&2
    elif [ -t 0 ] && [ -r /dev/tty ]; then
      printf '%s%s %s%s on project %s%s%s (production, no sandbox)\n' "$C_WARN" "$method" "$path" "$C_0" "$C_B" "$ORDERING_PROJECT" "$C_0" >/dev/tty
      printf 'Type the project ID to confirm: ' >/dev/tty
      local answer; IFS= read -r answer </dev/tty
      [ "$answer" = "$ORDERING_PROJECT" ] || die "Not confirmed. Nothing was sent."
    else
      die "$method changes production data and needs confirmation: run it yourself at an interactive terminal, or pass --yes after the person approved this exact request in the chat."
    fi
    audit_log "$method" "$path" "$data"
  fi

  local args=(-sS -m 30 -X "$method" -H "@$(header_file "X-Api-Key: $ORDERING_API_KEY")" -H "Accept: application/json")
  if [ -n "$data" ]; then
    case "$data" in @*) [ -f "${data#@}" ] || die "File not found: ${data#@}" ;; esac
    args+=(-H "Content-Type: application/json" --data-binary "$data")
  fi
  local tmp code
  tmp="$(tmpfile)"
  code="$(curl "${args[@]}" -o "$tmp" -w '%{http_code}' "$(api_base)$path")" || code="000"
  [ -n "$code" ] || code="000"
  redact_secrets "$tmp"
  pretty "$tmp"
  if [ "$code" = "000" ] || [ "$code" -ge 400 ]; then
    printf '%sHTTP %s%s\n' "$C_ERR" "$code" "$C_0" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------- spec

cmd_spec() {
  mkdir -p "$ROOT/spec"
  curl -fsS -m 60 -o "$ROOT/spec/openapi.json.tmp" "$SPEC_URL" || die "Download failed: $SPEC_URL"
  mv "$ROOT/spec/openapi.json.tmp" "$ROOT/spec/openapi.json"
  local n=""
  if have jq; then
    n="$(jq '[.paths[] | keys[] | select(. == "get" or . == "post" or . == "put" or . == "patch" or . == "delete")] | length' "$ROOT/spec/openapi.json" 2>/dev/null || true)"
  fi
  ok "Saved spec/openapi.json${n:+ ($n operations)}. Import it in Postman, or generate a typed client from it."
}

# ---------------------------------------------------------------- main

usage() {
  sed -n '2,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  echo
  echo "Docs: $DOCS_URL"
}

load_env
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  login)         cmd_login "$@" ;;
  init)          cmd_init "$@" ;;
  doctor)        cmd_doctor ;;
  install)       cmd_install ;;
  uninstall)     cmd_uninstall ;;
  logout|disconnect) cmd_logout ;;
  reset)         cmd_reset "$@" ;;
  shell-env)     cmd_shell_env ;;
  mcp)           cmd_mcp ;;
  clients)       client_action status ;;
  prepare)       client_runtime ;;
  claude)        cmd_claude "$@" ;;
  codex)         cmd_codex "$@" ;;
  cursor|code)   cmd_editor "$cmd" "$@" ;;
  api)           cmd_api "$@" ;;
  spec)          cmd_spec ;;
  help|-h|--help) usage ;;
  *)             usage; exit 1 ;;
esac
