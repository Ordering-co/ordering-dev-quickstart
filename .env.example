# Copy this file to .env and fill it in:  cp .env.example .env
# .env is gitignored. Never paste these keys into a chat with an AI. Paste them here.

# --- Your project ----------------------------------------------------------
# Your project ID (also called project code). Copy the Server URL from
# https://dashboard.ordering.co/settings?group=developers&category=developers&id=mcpTokens
# It looks like https://api.ordering.co/mcp/<project ID>
ORDERING_PROJECT=
# Language code used by the REST API. Use your project's language if it is not English.
ORDERING_LANG=en

# --- MCP: connect an AI agent (Claude Code, Codex, Cursor, VS Code) --------
# Dashboard > Settings > Apps & developers > API & integrations > MCP
# Starts with ord_mcp_. Shown only once. Start with a READ key.
# Keys expire (7 days by default). Run ./ordering doctor to see when.
ORDERING_MCP_KEY=

# --- REST API: call Ordering.co from your own code -------------------------
# Dashboard > Settings > Developers > API Keys > Add API key
# Sent as the X-Api-Key header. There is no sandbox: requests hit production.
ORDERING_API_KEY=

# --- Optional: a test user for requests/04-auth-session.http --------------
ORDERING_TEST_EMAIL=
ORDERING_TEST_PASSWORD=
